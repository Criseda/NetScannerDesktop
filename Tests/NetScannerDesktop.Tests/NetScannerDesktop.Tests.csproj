<Project Sdk="Microsoft.NET.Sdk">
	<!--
		Unit tests for the app's WinUI-free logic. The app itself is a WinUI
		exe that a test host cannot load, so the pure sources are compiled in
		directly: the parser, validation, list view, CSV and text table
		logic never touch Microsoft.UI.* or Windows.* on purpose.
		Run: dotnet test Tests/NetScannerDesktop.Tests
	-->
	<PropertyGroup>
		<TargetFramework>net9.0</TargetFramework>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<RootNamespace>NetScannerDesktop.Tests</RootNamespace>
		<AppDir>..\..\NetScannerDesktop\</AppDir>
		<NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<Compile Include="$(AppDir)Services\NetScannerParser.cs" Link="App\NetScannerParser.cs" />
		<Compile Include="$(AppDir)Services\NetworkValidation.cs" Link="App\NetworkValidation.cs" />
		<Compile Include="$(AppDir)Services\FilteredSortedView.cs" Link="App\FilteredSortedView.cs" />
		<Compile Include="$(AppDir)Services\Csv.cs" Link="App\Csv.cs" />
		<Compile Include="$(AppDir)Services\TableSort.cs" Link="App\TableSort.cs" />
		<Compile Include="$(AppDir)Services\TextTable.cs" Link="App\TextTable.cs" />
		<Compile Include="$(AppDir)Models\*.cs" Link="App\Models\%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="$(CommunityToolkitMvvmVersion)" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
	</ItemGroup>
</Project>
