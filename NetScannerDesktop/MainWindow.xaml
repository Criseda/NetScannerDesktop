<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NetScannerDesktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="NetScanner">

    <Grid>
        <!-- Full-window NavigationView: pane and content extend seamlessly to the top edge, matching Windows 11 Settings -->
        <NavigationView
            x:Name="Nav"
            PaneDisplayMode="Auto"
            ExpandedModeThresholdWidth="800"
            IsBackButtonVisible="Auto"
            IsBackEnabled="False"
            BackRequested="Nav_BackRequested"
            IsSettingsVisible="True"
            SelectionChanged="Nav_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Discovery" Tag="Discovery" Icon="Scan" />
                <NavigationViewItem Content="Port scan" Tag="Ports" Icon="Globe" />
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="About" Tag="About" Icon="Help" />
            </NavigationView.FooterMenuItems>

            <Frame x:Name="ContentFrame" />
        </NavigationView>

        <!-- Seamless draggable title bar region overlaid between the navigation controls and caption buttons -->
        <Grid
            x:Name="AppTitleBar"
            Height="40"
            VerticalAlignment="Top"
            Background="Transparent"
            Margin="48,0,140,0">
            <StackPanel
                Orientation="Horizontal"
                VerticalAlignment="Center"
                Spacing="8"
                IsHitTestVisible="False">
                <FontIcon
                    Glyph="&#xE774;"
                    FontSize="14"
                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                <TextBlock
                    Text="NetScanner"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    FontWeight="SemiBold"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
