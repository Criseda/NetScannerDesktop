<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="NetScannerDesktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:NetScannerDesktop">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Shared by every page: the Windows 11 card surface. -->
            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                <Setter Property="Padding" Value="20" />
            </Style>

            <!-- Secondary caption line under a form or list (status, estimates). -->
            <Style x:Key="HintTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--
                Field label in the scan toolbars, beside its box instead of
                above it so the toolbar stays one line tall. Centered on the
                box's row. Text boxes draw their text slightly above their
                middle (padding 5 top, 6 bottom, plus glyph metrics), so a
                plainly centered label reads low; the bottom margin lifts it
                onto the same line as the text in the box (checked on
                screenshots, cap tops and baselines match).
            -->
            <Style x:Key="ToolbarLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,0,0,3" />
            </Style>

            <!-- One-line status under a results card title; the tooltip carries anything trimmed. -->
            <Style x:Key="StatusLineTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
            </Style>

            <!-- Inline validation message; announced by screen readers when it appears. -->
            <Style x:Key="ErrorTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="AutomationProperties.LiveSetting" Value="Assertive" />
            </Style>

            <!-- Small neutral pill (TCP/ARP source, port category). -->
            <Style x:Key="ChipBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
                <Setter Property="Padding" Value="6,1" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Left" />
            </Style>

            <!--
                Results tables (Discovery hosts, Port scan ports): a header row
                of sort buttons above a ListView whose rows use the same column
                widths. Rows are single-line and separated by a hairline so a
                wide row stays easy to follow across.
            -->
            <x:Double x:Key="TableColumnSpacing">10</x:Double>
            <Thickness x:Key="TableRowPadding">12,0,12,0</Thickness>

            <Style x:Key="TableHeaderButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="Transparent" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="6,5" />
                <!-- Pull the label back so it lines up with the cell text below. -->
                <Setter Property="Margin" Value="-6,0,0,0" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>

            <Style x:Key="TableHeaderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TableSortGlyphStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="Margin" Value="6,1,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TableCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="TableCellStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableCellTextStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="TableCellSecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableCellTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>

            <!-- "Unknown", "Unassigned": present so the cell is not mistaken for missing data. -->
            <Style x:Key="TableCellPlaceholderTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TableCellTextStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorTertiaryBrush}" />
            </Style>

            <Style x:Key="TableRowContainerStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinHeight" Value="0" />
            </Style>

            <!-- Hairline under each row; the row grid sits inside with TableRowPadding. -->
            <Style x:Key="TableRowBorderStyle" TargetType="Border">
                <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="0,0,0,1" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="MinHeight" Value="40" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
