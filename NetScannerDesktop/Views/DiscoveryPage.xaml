<Page
    x:Class="NetScannerDesktop.Views.DiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NetScannerDesktop.Models"
    xmlns:services="using:NetScannerDesktop.Services"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="ScanAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="ScanAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
        <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CopyAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <!--
        Wide: the page fits the window and only the results list scrolls.
        Narrow: cards stack and the whole page scrolls (see ApplyLayoutMode).
    -->
    <ScrollViewer x:Name="PageScroller" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
        <Grid x:Name="RootGrid" Padding="32,16,32,24" RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition x:Name="CardsRow" Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Host discovery" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Find live hosts on your local network. A /24 usually takes about 2 seconds."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Row="1" Spacing="8">
                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsFirstRunTipOpen, Mode=TwoWay}"
                    Title="Find hosts on your LAN"
                    Message="Your subnet is pre-filled. Press Scan; results stream in live. Right-click a host for more actions."
                    Severity="Informational"
                    Closed="FirstRunTipBar_Closed" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                    Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}"
                    Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" />
                <InfoBar
                    IsOpen="{x:Bind ViewModel.IsUpdateAvailable, Mode=TwoWay}"
                    Title="Engine update available"
                    Message="{x:Bind ViewModel.UpdateAvailableText, Mode=OneWay}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button
                            Content="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}"
                            Command="{x:Bind ViewModel.UpdateEngineCommand}"
                            AutomationProperties.Name="Update engine now" />
                    </InfoBar.ActionButton>
                </InfoBar>
            </StackPanel>

            <Grid x:Name="CardsGrid" Grid.Row="2" ColumnSpacing="16" RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SetupColumn" Width="360" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="SetupRow" Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Scan setup -->
                <Border
                    x:Name="SetupCard"
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="0"
                    Style="{StaticResource CardBorderStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Padding="20" Spacing="16">
                            <TextBlock Text="Scan" Style="{StaticResource SubtitleTextBlockStyle}" />

                            <StackPanel Spacing="4">
                                <AutoSuggestBox
                                    x:Name="SubnetBox"
                                    Header="Subnet"
                                    PlaceholderText="192.168.1.0/24"
                                    Text="{x:Bind ViewModel.Subnet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    ItemsSource="{x:Bind ViewModel.SubnetSuggestions}"
                                    AutomationProperties.HelpText="{x:Bind ViewModel.SubnetErrorText, Mode=OneWay}"
                                    GotFocus="SubnetBox_GotFocus"
                                    TextChanged="SubnetBox_TextChanged"
                                    SuggestionChosen="SubnetBox_SuggestionChosen"
                                    QuerySubmitted="SubnetBox_QuerySubmitted">
                                    <AutoSuggestBox.ItemTemplate>
                                        <DataTemplate x:DataType="services:SubnetSuggestion">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind Cidr}" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    Text="{x:Bind Label}"
                                                    Style="{StaticResource HintTextStyle}"
                                                    VerticalAlignment="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </AutoSuggestBox.ItemTemplate>
                                </AutoSuggestBox>
                                <TextBlock
                                    Text="{x:Bind ViewModel.SubnetErrorText, Mode=OneWay}"
                                    Style="{StaticResource ErrorTextStyle}"
                                    Visibility="{x:Bind ViewModel.HasSubnetError, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.HostEstimateText, Mode=OneWay}"
                                    Style="{StaticResource HintTextStyle}" />
                            </StackPanel>

                            <RadioButtons
                                Header="Method"
                                SelectedIndex="{x:Bind ViewModel.MethodIndex, Mode=TwoWay}">
                                <RadioButton>
                                    <StackPanel>
                                        <TextBlock Text="TCP + ARP" />
                                        <TextBlock Text="Fast. Finds quiet hosts from the ARP table too." Style="{StaticResource HintTextStyle}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton>
                                    <StackPanel>
                                        <TextBlock Text="ICMP ping" />
                                        <TextBlock Text="Slower. For networks that filter TCP probes." Style="{StaticResource HintTextStyle}" />
                                    </StackPanel>
                                </RadioButton>
                            </RadioButtons>

                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Button
                                        Style="{StaticResource AccentButtonStyle}"
                                        Command="{x:Bind ViewModel.ScanCommand}"
                                        ToolTipService.ToolTip="Scan (F5)"
                                        AutomationProperties.Name="Start discovery scan">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                                            <TextBlock Text="Scan" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        Content="Cancel"
                                        Command="{x:Bind ViewModel.CancelCommand}"
                                        IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                        ToolTipService.ToolTip="Cancel (Esc)"
                                        AutomationProperties.Name="Cancel discovery scan" />
                                </StackPanel>
                                <ProgressBar
                                    IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                    Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}" />
                                <TextBlock
                                    Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                                    Style="{StaticResource HintTextStyle}"
                                    AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <!-- Results -->
                <Border
                    x:Name="ResultsCard"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid RowSpacing="12">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{x:Bind ViewModel.HostCountTitle, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <Button
                                    Command="{x:Bind ViewModel.CopyResultsCommand}"
                                    ToolTipService.ToolTip="Copy all IP addresses (Ctrl+Shift+C)"
                                    AutomationProperties.Name="Copy all IP addresses">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                        <TextBlock Text="Copy" />
                                    </StackPanel>
                                </Button>
                                <Button Command="{x:Bind ViewModel.ExportCsvCommand}" AutomationProperties.Name="Export results as CSV">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                        <TextBlock Text="Export" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="FilterBox"
                                PlaceholderText="Filter hosts (Ctrl+F)"
                                AutomationProperties.Name="Filter hosts"
                                Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ComboBox
                                Grid.Column="1"
                                MinWidth="150"
                                SelectedIndex="{x:Bind ViewModel.SortIndex, Mode=TwoWay}"
                                AutomationProperties.Name="Sort hosts">
                                <ComboBoxItem Content="Sort by IP" />
                                <ComboBoxItem Content="Sort by time found" />
                            </ComboBox>
                        </Grid>

                        <ListView
                            x:Name="HostsList"
                            Grid.Row="2"
                            MinHeight="240"
                            ItemsSource="{x:Bind ViewModel.FilteredHosts, Mode=OneWay}"
                            SelectionMode="Single"
                            DoubleTapped="HostsList_DoubleTapped"
                            AutomationProperties.Name="Discovered hosts">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:HostResult">
                                    <Grid ColumnSpacing="12" Padding="0,8" AutomationProperties.Name="{x:Bind IpAddress}">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Scan ports" Tag="{x:Bind IpAddress}" Click="ScanPorts_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE839;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copy IP address" Tag="{x:Bind IpAddress}" Click="CopyHost_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Copy details" Tag="{x:Bind IpAddress}" Click="CopySummary_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Open in browser (HTTP)" Tag="{x:Bind IpAddress}" Click="OpenHttp_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Open in browser (HTTPS)" Tag="{x:Bind IpAddress}" Click="OpenHttps_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            Glyph="&#xE977;"
                                            FontSize="18"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock
                                                Text="{x:Bind IpAddress}"
                                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                                IsTextSelectionEnabled="True"
                                                TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Text="{x:Bind PortsSummary, Mode=OneWay}"
                                                Visibility="{x:Bind HasScannedPorts, Mode=OneWay}"
                                                Style="{StaticResource HintTextStyle}"
                                                TextWrapping="NoWrap"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <Border Grid.Column="2" Style="{StaticResource ChipBorderStyle}">
                                            <TextBlock
                                                Text="{x:Bind Source}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                        <TextBlock
                                            Grid.Column="3"
                                            Text="{x:Bind FoundAtShort}"
                                            Style="{StaticResource HintTextStyle}"
                                            VerticalAlignment="Center" />
                                        <HyperlinkButton
                                            Grid.Column="4"
                                            Content="{x:Bind PortsButtonText, Mode=OneWay}"
                                            Tag="{x:Bind IpAddress}"
                                            Click="ScanPorts_Click"
                                            VerticalAlignment="Center"
                                            Padding="8,2" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            Grid.Row="2"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,24"
                            Spacing="8">
                            <FontIcon
                                Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay}"
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                MaxWidth="340"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <Expander Grid.Row="3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <Expander.Header>
                    <Grid>
                        <TextBlock Text="Engine output" VerticalAlignment="Center" />
                        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}">
                            <Run Text="ns " /><Run Text="{x:Bind ViewModel.EngineVersion, Mode=OneWay}" />
                        </TextBlock>
                    </Grid>
                </Expander.Header>
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Copy log" Command="{x:Bind ViewModel.CopyLogCommand}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.LogLineCountText, Mode=OneWay}"
                            Style="{StaticResource HintTextStyle}"
                            VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBox
                        Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                        IsReadOnly="True"
                        AcceptsReturn="True"
                        TextWrapping="Wrap"
                        FontFamily="Cascadia Mono, Consolas"
                        MinHeight="120"
                        MaxHeight="200"
                        AutomationProperties.Name="Engine output"
                        ScrollViewer.VerticalScrollBarVisibility="Auto"
                        TextChanged="LogBox_TextChanged" />
                </StackPanel>
            </Expander>
        </Grid>
    </ScrollViewer>
</Page>
