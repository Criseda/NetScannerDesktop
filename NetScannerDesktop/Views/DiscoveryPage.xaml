<Page
    x:Class="NetScannerDesktop.Views.DiscoveryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:NetScannerDesktop.Views"
    xmlns:models="using:NetScannerDesktop.Models"
    xmlns:services="using:NetScannerDesktop.Services"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="ScanAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="ScanAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
        <KeyboardAccelerator Key="C" Modifiers="Control,Shift" Invoked="CopyAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <Page.Resources>
        <!--
            Host table columns, shared by the header row and every host row
            so they always line up. Fixed widths for values of known length,
            stars for names that vary. Below HostsTableMinWidth the table
            scrolls sideways instead of squeezing columns.
        -->
        <GridLength x:Key="HostIconColumn">20</GridLength>
        <GridLength x:Key="HostNameColumn">1.2*</GridLength>
        <GridLength x:Key="HostIpColumn">120</GridLength>
        <GridLength x:Key="HostVendorColumn">1.2*</GridLength>
        <GridLength x:Key="HostMacColumn">136</GridLength>
        <GridLength x:Key="HostSourceColumn">68</GridLength>
        <GridLength x:Key="HostPortsColumn">1.4*</GridLength>
        <GridLength x:Key="HostFoundColumn">72</GridLength>
        <GridLength x:Key="HostActionColumn">92</GridLength>
    </Page.Resources>

    <!-- The page always fits the window; only the host table scrolls. -->
    <Grid x:Name="RootGrid" Padding="24,12,24,20" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="Host discovery" Style="{StaticResource TitleTextBlockStyle}" />
            <TextBlock
                Text="Find live hosts on your local network. A /24 usually takes about 2 seconds."
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsFirstRunTipOpen, Mode=TwoWay}"
                Title="Find hosts on your LAN"
                Message="Your subnet is pre-filled. Press Scan; results stream in live. Click a column header to sort, right-click a host for more actions."
                Severity="Informational"
                Closed="FirstRunTipBar_Closed" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}" />
            <InfoBar
                IsOpen="{x:Bind ViewModel.IsUpdateAvailable, Mode=TwoWay}"
                Title="Engine update available"
                Message="{x:Bind ViewModel.UpdateAvailableText, Mode=OneWay}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button
                        Content="{x:Bind ViewModel.UpdateButtonText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.UpdateEngineCommand}"
                        AutomationProperties.Name="Update engine now" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!--
            Scan toolbar: one slim line, labels beside their boxes. Wraps when
            the window is too narrow. Progress and results status live in the
            results card below, next to what they describe.
        -->
        <Border Grid.Row="2" Padding="16,10" Style="{StaticResource CardBorderStyle}">
            <local:WrapPanel HorizontalSpacing="24" VerticalSpacing="8">
                <Grid ColumnSpacing="10" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Subnet" Style="{StaticResource ToolbarLabelStyle}" />
                    <AutoSuggestBox
                        x:Name="SubnetBox"
                        Grid.Column="1"
                        PlaceholderText="192.168.1.0/24"
                        Text="{x:Bind ViewModel.Subnet, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        ItemsSource="{x:Bind ViewModel.SubnetSuggestions}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.HostEstimateText, Mode=OneWay}"
                        AutomationProperties.Name="Subnet"
                        AutomationProperties.HelpText="{x:Bind ViewModel.SubnetErrorText, Mode=OneWay}"
                        GotFocus="SubnetBox_GotFocus"
                        TextChanged="SubnetBox_TextChanged"
                        SuggestionChosen="SubnetBox_SuggestionChosen"
                        QuerySubmitted="SubnetBox_QuerySubmitted">
                        <AutoSuggestBox.ItemTemplate>
                            <!--
                                The dropdown is only as wide as the box, so the
                                subnet always gets its full width and the adapter
                                name takes what is left, trimmed (tooltip has it all).
                            -->
                            <DataTemplate x:DataType="services:SubnetSuggestion">
                                <Grid ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind Label}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind Cidr}" TextWrapping="NoWrap" VerticalAlignment="Center" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Text="{x:Bind Label}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        TextWrapping="NoWrap"
                                        TextTrimming="CharacterEllipsis"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </AutoSuggestBox.ItemTemplate>
                    </AutoSuggestBox>
                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Text="{x:Bind ViewModel.SubnetErrorText, Mode=OneWay}"
                        Style="{StaticResource ErrorTextStyle}"
                        Visibility="{x:Bind ViewModel.HasSubnetError, Mode=OneWay}" />
                </Grid>

                <StackPanel Orientation="Horizontal" Spacing="10">
                    <TextBlock Text="Method" Style="{StaticResource ToolbarLabelStyle}" />
                    <ComboBox
                        Width="170"
                        SelectedIndex="{x:Bind ViewModel.MethodIndex, Mode=TwoWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.MethodHint, Mode=OneWay}"
                        AutomationProperties.Name="Method"
                        AutomationProperties.HelpText="{x:Bind ViewModel.MethodHint, Mode=OneWay}">
                        <ComboBoxItem Content="TCP + ARP (fast)" ToolTipService.ToolTip="Fast. Also finds quiet hosts in the ARP table." />
                        <ComboBoxItem Content="ICMP ping (slow)" ToolTipService.ToolTip="Slower. For networks that filter TCP probes." />
                    </ComboBox>
                </StackPanel>

                <StackPanel
                    Orientation="Horizontal"
                    Spacing="10"
                    ToolTipService.ToolTip="Looks up hostnames (mDNS, NetBIOS, DNS), MAC addresses and manufacturers. Adds a moment after the sweep.">
                    <TextBlock Text="Identify devices" Style="{StaticResource ToolbarLabelStyle}" />
                    <ToggleSwitch
                        MinWidth="0"
                        IsOn="{x:Bind ViewModel.IdentifyDevices, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.CanIdentifyDevices, Mode=OneWay}"
                        AutomationProperties.Name="Identify devices">
                        <!-- 10+20+10 by default; 6+20+6 matches the 32px boxes beside it. -->
                        <ToggleSwitch.Resources>
                            <x:Double x:Key="ToggleSwitchPreContentMargin">6</x:Double>
                            <x:Double x:Key="ToggleSwitchPostContentMargin">6</x:Double>
                        </ToggleSwitch.Resources>
                        <!-- Same nudge as ToolbarLabelStyle, so On/Off sits on the toolbar's text line. -->
                        <ToggleSwitch.OnContent>
                            <TextBlock Text="On" Margin="0,0,0,3" />
                        </ToggleSwitch.OnContent>
                        <ToggleSwitch.OffContent>
                            <TextBlock Text="Off" Margin="0,0,0,3" />
                        </ToggleSwitch.OffContent>
                    </ToggleSwitch>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button
                        Style="{StaticResource AccentButtonStyle}"
                        Command="{x:Bind ViewModel.ScanCommand}"
                        ToolTipService.ToolTip="Scan (F5)"
                        AutomationProperties.Name="Start discovery scan">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE768;" FontSize="14" />
                            <TextBlock Text="Scan" />
                        </StackPanel>
                    </Button>
                    <Button
                        Content="Cancel"
                        Command="{x:Bind ViewModel.CancelCommand}"
                        IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                        ToolTipService.ToolTip="Cancel (Esc)"
                        AutomationProperties.Name="Cancel discovery scan" />
                </StackPanel>
            </local:WrapPanel>
        </Border>

        <!-- Results: a full-width table, one host per row. -->
        <Border Grid.Row="3" Padding="0" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Title, filter and actions on one line; the live status runs
                    full width under them, so a long status never squeezes the
                    filter and a narrow window never truncates the title.
                -->
                <Grid Padding="20,12,20,10" ColumnSpacing="12" RowSpacing="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Text="{x:Bind ViewModel.HostCountTitle, Mode=OneWay}"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="NoWrap"
                        VerticalAlignment="Center" />
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="3"
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        Style="{StaticResource StatusLineTextStyle}" />
                    <TextBox
                        x:Name="FilterBox"
                        Grid.Column="1"
                        MaxWidth="360"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        PlaceholderText="Filter hosts (Ctrl+F)"
                        AutomationProperties.Name="Filter hosts"
                        Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <!-- Main part copies the IP list; the arrow picks another column or the whole table. -->
                        <SplitButton
                            Command="{x:Bind ViewModel.CopyResultsCommand}"
                            ToolTipService.ToolTip="Copy IP addresses (Ctrl+Shift+C). The arrow has more."
                            AutomationProperties.Name="Copy IP addresses">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8C8;" FontSize="14" />
                                <TextBlock Text="Copy" />
                            </StackPanel>
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem Text="IP addresses" Command="{x:Bind ViewModel.CopyResultsCommand}" KeyboardAcceleratorTextOverride="Ctrl+Shift+C" />
                                    <MenuFlyoutItem Text="Names" Command="{x:Bind ViewModel.CopyNamesCommand}" />
                                    <MenuFlyoutItem Text="MAC addresses" Command="{x:Bind ViewModel.CopyMacAddressesCommand}" />
                                    <MenuFlyoutSeparator />
                                    <MenuFlyoutItem Text="Everything (as a table)" Command="{x:Bind ViewModel.CopyTableCommand}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button Command="{x:Bind ViewModel.ExportCsvCommand}" AutomationProperties.Name="Export results as CSV">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xEDE1;" FontSize="14" />
                                <TextBlock Text="Export" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <ScrollViewer
                    x:Name="HostsTableScroller"
                    Grid.Row="1"
                    Margin="8,0,8,8"
                    HorizontalScrollMode="Auto"
                    HorizontalScrollBarVisibility="Auto"
                    VerticalScrollMode="Disabled"
                    VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="HostsTable" HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Column headers: click to sort, click again to reverse. -->
                        <Border
                            Padding="{StaticResource TableRowPadding}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid ColumnSpacing="{StaticResource TableColumnSpacing}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{StaticResource HostIconColumn}" />
                                    <ColumnDefinition Width="{StaticResource HostNameColumn}" />
                                    <ColumnDefinition Width="{StaticResource HostIpColumn}" />
                                    <ColumnDefinition Width="{StaticResource HostVendorColumn}" />
                                    <ColumnDefinition Width="{StaticResource HostMacColumn}" />
                                    <ColumnDefinition Width="{StaticResource HostSourceColumn}" />
                                    <ColumnDefinition Width="{StaticResource HostPortsColumn}" />
                                    <ColumnDefinition Width="{StaticResource HostFoundColumn}" />
                                    <ColumnDefinition Width="{StaticResource HostActionColumn}" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="1" Style="{StaticResource TableHeaderButtonStyle}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="name" AutomationProperties.Name="Sort by name">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Name" />
                                        <FontIcon Glyph="{x:Bind ViewModel.SortGlyph('name', ViewModel.SortColumn, ViewModel.SortDescending), Mode=OneWay}" Style="{StaticResource TableSortGlyphStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Style="{StaticResource TableHeaderButtonStyle}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="ip" AutomationProperties.Name="Sort by IP address">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="IP address" />
                                        <FontIcon Glyph="{x:Bind ViewModel.SortGlyph('ip', ViewModel.SortColumn, ViewModel.SortDescending), Mode=OneWay}" Style="{StaticResource TableSortGlyphStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource TableHeaderButtonStyle}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="vendor" AutomationProperties.Name="Sort by manufacturer">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Manufacturer" />
                                        <FontIcon Glyph="{x:Bind ViewModel.SortGlyph('vendor', ViewModel.SortColumn, ViewModel.SortDescending), Mode=OneWay}" Style="{StaticResource TableSortGlyphStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="4" Style="{StaticResource TableHeaderButtonStyle}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="mac" AutomationProperties.Name="Sort by MAC address">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="MAC address" />
                                        <FontIcon Glyph="{x:Bind ViewModel.SortGlyph('mac', ViewModel.SortColumn, ViewModel.SortDescending), Mode=OneWay}" Style="{StaticResource TableSortGlyphStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="5"
                                    Style="{StaticResource TableHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByCommand}"
                                    CommandParameter="source"
                                    ToolTipService.ToolTip="How the host answered: TCP probe, the ARP table (quiet on TCP) or ICMP ping"
                                    AutomationProperties.Name="Sort by how the host was found">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Found via" />
                                        <FontIcon Glyph="{x:Bind ViewModel.SortGlyph('source', ViewModel.SortColumn, ViewModel.SortDescending), Mode=OneWay}" Style="{StaticResource TableSortGlyphStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    Grid.Column="6"
                                    Style="{StaticResource TableHeaderButtonStyle}"
                                    Command="{x:Bind ViewModel.SortByCommand}"
                                    CommandParameter="ports"
                                    ToolTipService.ToolTip="From the last port scan of each host"
                                    AutomationProperties.Name="Sort by number of open ports">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Open ports" />
                                        <FontIcon Glyph="{x:Bind ViewModel.SortGlyph('ports', ViewModel.SortColumn, ViewModel.SortDescending), Mode=OneWay}" Style="{StaticResource TableSortGlyphStyle}" />
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="7" Style="{StaticResource TableHeaderButtonStyle}" Command="{x:Bind ViewModel.SortByCommand}" CommandParameter="found" AutomationProperties.Name="Sort by time found">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Found at" />
                                        <FontIcon Glyph="{x:Bind ViewModel.SortGlyph('found', ViewModel.SortColumn, ViewModel.SortDescending), Mode=OneWay}" Style="{StaticResource TableSortGlyphStyle}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- While scanning, the header underline becomes the progress bar. -->
                        <ProgressBar
                            VerticalAlignment="Bottom"
                            IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                            AutomationProperties.Name="Scan progress" />

                        <ListView
                            x:Name="HostsList"
                            Grid.Row="1"
                            ItemsSource="{x:Bind ViewModel.VisibleHosts}"
                            ItemContainerStyle="{StaticResource TableRowContainerStyle}"
                            SelectionMode="Single"
                            DoubleTapped="HostsList_DoubleTapped"
                            KeyDown="HostsList_KeyDown"
                            AutomationProperties.Name="Discovered hosts">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:HostResult">
                                    <Border Style="{StaticResource TableRowBorderStyle}">
                                        <Border.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Scan ports" Tag="{x:Bind IpAddress}" Click="ScanPorts_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE839;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <!-- One entry per column; unknown fields are greyed out. -->
                                                <MenuFlyoutSubItem Text="Copy">
                                                    <MenuFlyoutSubItem.Icon><FontIcon Glyph="&#xE8C8;" /></MenuFlyoutSubItem.Icon>
                                                    <MenuFlyoutItem Text="IP address" Tag="{x:Bind IpAddress}" Click="CopyIp_Click" KeyboardAcceleratorTextOverride="Ctrl+C" />
                                                    <MenuFlyoutItem Text="Name" Tag="{x:Bind IpAddress}" Click="CopyName_Click" IsEnabled="{x:Bind HasHostname, Mode=OneWay}" />
                                                    <MenuFlyoutItem Text="MAC address" Tag="{x:Bind IpAddress}" Click="CopyMac_Click" IsEnabled="{x:Bind HasMacAddress, Mode=OneWay}" />
                                                    <MenuFlyoutItem Text="Manufacturer" Tag="{x:Bind IpAddress}" Click="CopyVendor_Click" IsEnabled="{x:Bind HasVendor, Mode=OneWay}" />
                                                    <MenuFlyoutItem Text="Open ports" Tag="{x:Bind IpAddress}" Click="CopyPorts_Click" IsEnabled="{x:Bind HasOpenPorts, Mode=OneWay}" />
                                                    <MenuFlyoutSeparator />
                                                    <MenuFlyoutItem Text="All details" Tag="{x:Bind IpAddress}" Click="CopyAll_Click" />
                                                </MenuFlyoutSubItem>
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Open in browser (HTTP)" Tag="{x:Bind IpAddress}" Click="OpenHttp_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE774;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                                <MenuFlyoutItem Text="Open in browser (HTTPS)" Tag="{x:Bind IpAddress}" Click="OpenHttps_Click">
                                                    <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72E;" /></MenuFlyoutItem.Icon>
                                                </MenuFlyoutItem>
                                            </MenuFlyout>
                                        </Border.ContextFlyout>
                                        <Grid
                                            Padding="{StaticResource TableRowPadding}"
                                            ColumnSpacing="{StaticResource TableColumnSpacing}"
                                            AutomationProperties.Name="{x:Bind DisplayName, Mode=OneWay}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="{StaticResource HostIconColumn}" />
                                                <ColumnDefinition Width="{StaticResource HostNameColumn}" />
                                                <ColumnDefinition Width="{StaticResource HostIpColumn}" />
                                                <ColumnDefinition Width="{StaticResource HostVendorColumn}" />
                                                <ColumnDefinition Width="{StaticResource HostMacColumn}" />
                                                <ColumnDefinition Width="{StaticResource HostSourceColumn}" />
                                                <ColumnDefinition Width="{StaticResource HostPortsColumn}" />
                                                <ColumnDefinition Width="{StaticResource HostFoundColumn}" />
                                                <ColumnDefinition Width="{StaticResource HostActionColumn}" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                Glyph="&#xE977;"
                                                FontSize="16"
                                                HorizontalAlignment="Left"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Text="{x:Bind Hostname, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind Hostname, Mode=OneWay}"
                                                Style="{StaticResource TableCellStrongTextStyle}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                Text="{x:Bind IpAddress}"
                                                Style="{StaticResource TableCellTextStyle}" />
                                            <TextBlock
                                                Grid.Column="3"
                                                Text="{x:Bind Vendor, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind Vendor, Mode=OneWay}"
                                                Style="{StaticResource TableCellTextStyle}" />
                                            <TextBlock
                                                Grid.Column="4"
                                                Text="{x:Bind MacAddress, Mode=OneWay}"
                                                Style="{StaticResource TableCellSecondaryTextStyle}" />
                                            <Border Grid.Column="5" Style="{StaticResource ChipBorderStyle}">
                                                <TextBlock
                                                    Text="{x:Bind Source}"
                                                    Style="{StaticResource CaptionTextBlockStyle}"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Border>
                                            <TextBlock
                                                Grid.Column="6"
                                                Text="{x:Bind PortsSummary, Mode=OneWay}"
                                                ToolTipService.ToolTip="{x:Bind PortsDetail, Mode=OneWay}"
                                                Style="{StaticResource TableCellSecondaryTextStyle}" />
                                            <TextBlock
                                                Grid.Column="7"
                                                Text="{x:Bind FoundAtShort}"
                                                Style="{StaticResource TableCellSecondaryTextStyle}" />
                                            <HyperlinkButton
                                                Grid.Column="8"
                                                Padding="8,2"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Center"
                                                Content="{x:Bind PortsButtonText, Mode=OneWay}"
                                                Tag="{x:Bind IpAddress}"
                                                Click="ScanPorts_Click" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>

                        <StackPanel
                            Grid.Row="1"
                            Visibility="{x:Bind ViewModel.ShowEmptyState, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,24"
                            Spacing="8">
                            <FontIcon
                                Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay}"
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.EmptyStateTitle, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}"
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                MaxWidth="340"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>

        <Expander Grid.Row="4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.Header>
                <Grid>
                    <TextBlock Text="Engine output" VerticalAlignment="Center" />
                    <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" Style="{StaticResource HintTextStyle}">
                        <Run Text="ns " /><Run Text="{x:Bind ViewModel.EngineVersion, Mode=OneWay}" />
                    </TextBlock>
                </Grid>
            </Expander.Header>
            <StackPanel Spacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Copy log" Command="{x:Bind ViewModel.CopyLogCommand}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.LogLineCountText, Mode=OneWay}"
                        Style="{StaticResource HintTextStyle}"
                        VerticalAlignment="Center" />
                </StackPanel>
                <TextBox
                    Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                    IsReadOnly="True"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    FontFamily="Cascadia Mono, Consolas"
                    MinHeight="120"
                    MaxHeight="200"
                    AutomationProperties.Name="Engine output"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    TextChanged="LogBox_TextChanged" />
            </StackPanel>
        </Expander>
    </Grid>
</Page>
