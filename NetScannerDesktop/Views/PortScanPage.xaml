<Page
    x:Class="NetScannerDesktop.Views.PortScanPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:NetScannerDesktop.Models"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Page.Resources>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="20" />
        </Style>
    </Page.Resources>

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator Key="F" Modifiers="Control" Invoked="FilterAccelerator_Invoked" />
        <KeyboardAccelerator Key="R" Modifiers="Control" Invoked="ScanAccelerator_Invoked" />
        <KeyboardAccelerator Key="F5" Invoked="ScanAccelerator_Invoked" />
        <KeyboardAccelerator Key="Escape" Invoked="CancelAccelerator_Invoked" />
    </Page.KeyboardAccelerators>

    <ScrollViewer>
        <Grid
            x:Name="RootGrid"
            Padding="32,24,32,32"
            RowSpacing="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock Text="Port scan" Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock
                    Text="Probe one host for open TCP ports. A full 1-1024 sweep usually takes a few seconds."
                    Style="{StaticResource BodyTextBlockStyle}"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>

            <InfoBar
                Grid.Row="1"
                IsOpen="{x:Bind ViewModel.IsNoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.NoticeText, Mode=OneWay}"
                Severity="{x:Bind ViewModel.NoticeSeverity, Mode=OneWay}"
                IsClosable="True" />

            <Grid
                Grid.Row="2"
                ColumnSpacing="16"
                RowSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="SetupColumn" Width="380" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Scan setup -->
                <Border
                    x:Name="SetupCard"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Scan" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBox
                            Header="IP address"
                            PlaceholderText="192.168.1.1"
                            Text="{x:Bind ViewModel.IpAddress, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="Input_KeyDown" />
                        <TextBlock
                            Text="{x:Bind ViewModel.IpErrorText, Mode=OneWay}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.IpErrorVisibility, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <ComboBox
                            Header="Recent hosts"
                            PlaceholderText="Previously scanned"
                            HorizontalAlignment="Stretch"
                            ItemsSource="{x:Bind ViewModel.RecentIps, Mode=OneWay}"
                            SelectedItem="{x:Bind ViewModel.SelectedRecentIp, Mode=TwoWay}" />
                        <TextBox
                            Header="Port range"
                            PlaceholderText="1-1024"
                            Description="Start and end port, 1-65535. Either order works."
                            Text="{x:Bind ViewModel.PortRange, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="Input_KeyDown" />
                        <TextBlock
                            Text="{x:Bind ViewModel.PortRangeErrorText, Mode=OneWay}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.PortRangeErrorVisibility, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBox
                            Header="Timeout per port (ms)"
                            PlaceholderText="500"
                            Description="Engine default is 500ms. Raise on slow networks, lower on fast LANs. 1-60000."
                            Text="{x:Bind ViewModel.TimeoutMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                            KeyDown="Input_KeyDown" />
                        <TextBlock
                            Text="{x:Bind ViewModel.TimeoutErrorText, Mode=OneWay}"
                            Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Visibility="{x:Bind ViewModel.TimeoutErrorVisibility, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            Text="{x:Bind ViewModel.PortEstimateText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                Content="Scan"
                                Style="{StaticResource AccentButtonStyle}"
                                Command="{x:Bind ViewModel.ScanCommand}"
                                AutomationProperties.Name="Start port scan" />
                            <Button
                                Content="Cancel"
                                Command="{x:Bind ViewModel.CancelCommand}"
                                IsEnabled="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                                AutomationProperties.Name="Cancel port scan" />
                        </StackPanel>
                        <ProgressBar
                            IsIndeterminate="{x:Bind ViewModel.IsScanning, Mode=OneWay}"
                            Visibility="{x:Bind ViewModel.ScanProgressVisibility, Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Results -->
                <Border
                    x:Name="ResultsCard"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Grid.Column="0"
                                Text="{x:Bind ViewModel.PortCountTitle, Mode=OneWay}"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                VerticalAlignment="Center"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="Copy" Command="{x:Bind ViewModel.CopyResultsCommand}" />
                                <Button Content="Export CSV" Command="{x:Bind ViewModel.ExportCsvCommand}" />
                            </StackPanel>
                        </Grid>
                        <TextBox
                            x:Name="FilterBox"
                            PlaceholderText="Filter ports or services… (Ctrl+F)"
                            Text="{x:Bind ViewModel.FilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel
                            x:Name="EmptyStatePanel"
                            Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="0,32,0,32"
                            Spacing="10">
                            <FontIcon
                                Glyph="&#xE81E;"
                                FontSize="32"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="Ready to scan ports"
                                Style="{StaticResource SubtitleTextBlockStyle}"
                                HorizontalAlignment="Center" />
                            <TextBlock
                                Text="Enter a target IP address or pick a recent host to probe for open TCP services."
                                Style="{StaticResource BodyTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextAlignment="Center"
                                MaxWidth="320"
                                TextWrapping="Wrap" />
                            <Button
                                Content="Start port scan"
                                Style="{StaticResource AccentButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,4,0,0"
                                Command="{x:Bind ViewModel.ScanCommand}" />
                        </StackPanel>
                        <ListView
                            x:Name="PortsList"
                            ItemsSource="{x:Bind ViewModel.FilteredPorts, Mode=OneWay}"
                            SelectionMode="Single"
                            MinHeight="320"
                            MaxHeight="560"
                            DoubleTapped="PortsList_DoubleTapped"
                            AutomationProperties.Name="Open ports">
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:PortResult">
                                    <Grid ColumnSpacing="12" Padding="0,6">
                                        <Grid.ContextFlyout>
                                            <MenuFlyout>
                                                <MenuFlyoutItem Text="Copy port" Tag="{x:Bind Port}" Click="CopyPort_Click" Icon="Copy" />
                                                <MenuFlyoutItem Text="Copy host:port" Tag="{x:Bind Port}" Click="CopyHostPort_Click" />
                                                <MenuFlyoutSeparator />
                                                <MenuFlyoutItem Text="Open in browser (HTTP)" Tag="{x:Bind Port}" Click="OpenPortHttp_Click" Icon="World" />
                                                <MenuFlyoutItem Text="Open in browser (HTTPS)" Tag="{x:Bind Port}" Click="OpenPortHttps_Click" Icon="Permissions" />
                                            </MenuFlyout>
                                        </Grid.ContextFlyout>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0" Glyph="&#xE81E;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Text="{x:Bind Port}"
                                            Style="{StaticResource BodyStrongTextBlockStyle}"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            Grid.Column="2"
                                            Text="{x:Bind Service}"
                                            Style="{StaticResource BodyTextBlockStyle}"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            VerticalAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                        <Border
                                            Grid.Column="3"
                                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,2"
                                            VerticalAlignment="Center">
                                            <TextBlock
                                                Text="{x:Bind Category}"
                                                Style="{StaticResource CaptionTextBlockStyle}"
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </Border>
            </Grid>

            <Expander
                Grid.Row="3"
                Header="Engine output"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch">
                <Expander.Content>
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Copy log" Command="{x:Bind ViewModel.CopyLogCommand}" />
                            <TextBlock
                                Text="{x:Bind ViewModel.LogLineCountText, Mode=OneWay}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBox
                            x:Name="LogBox"
                            Text="{x:Bind ViewModel.LogText, Mode=OneWay}"
                            IsReadOnly="True"
                            AcceptsReturn="True"
                            TextWrapping="Wrap"
                            FontFamily="Consolas"
                            MinHeight="120"
                            MaxHeight="240"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            TextChanged="LogBox_TextChanged" />
                    </StackPanel>
                </Expander.Content>
            </Expander>

        </Grid>
    </ScrollViewer>
</Page>
